# Copia este archivo a .env y ajusta los valores. NO subas .env al repositorio.
PORT=4000
NODE_ENV=development

# Conexión a PostgreSQL (local con docker-compose o Neon/Supabase/Railway)
DATABASE_URL=postgresql://medleads:medleads@localhost:5433/medleads
# true para servicios gestionados que exigen SSL (Neon, Supabase, Railway)
DATABASE_SSL=false
# true crea/actualiza tablas automaticamente
DB_SYNC=true

# Contraseña del único usuario administrador del panel /admin
ADMIN_PASSWORD=cambia-esta-clave
# Secreto para firmar el JWT 
JWT_SECRET=cambia-este-secreto-largo-y-aleatorio
